<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- FOREGROUND_SERVICE: permite que el Service se mantenga visible en el panel de notificaciones -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FOREGROUND_SERVICE_DATA_SYNC: requerido en targetSdk >= 34 para servicios que hacen red en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- POST_NOTIFICATIONS: requerido en API 33+ para mostrar notificaciones al usuario -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Paso 1: Permiso para leer imágenes de la galería -->
    <!-- Android 13+ (API 33): permiso granular solo para imágenes -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />
    <!-- Android 12 y anteriores (API ≤ 32): permiso general de almacenamiento externo -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ActivitiesAndViews">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Referencia: navegacion Activity-based (clase anterior) -->
        <activity android:name=".LoginActivity" />
        <activity android:name=".HomeActivity" />

        <!-- foregroundServiceType="dataSync" es obligatorio en targetSdk >= 34 para servicios de red -->
        <service
            android:name=".service.PollingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>
