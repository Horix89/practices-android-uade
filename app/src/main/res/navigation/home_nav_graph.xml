<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_nav_graph"
    app:startDestination="@id/homeFragment">

    <argument
        android:name="username"
        app:argType="string"
        android:defaultValue="" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.activitiesandviews.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <argument
            android:name="username"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_home_to_pokemon"
            app:destination="@id/pokemonListFragment" />

        <action
            android:id="@+id/action_home_to_storage"
            app:destination="@id/storageMenuFragment" />

        <action
            android:id="@+id/action_home_to_biometric"
            app:destination="@id/biometricFragment" />

        <action
            android:id="@+id/action_home_to_material_demo"
            app:destination="@id/materialDemoFragment" />

        <action
            android:id="@+id/action_home_to_qr"
            app:destination="@id/qrScanFragment" />
    </fragment>

    <fragment
        android:id="@+id/qrScanFragment"
        android:name="com.example.activitiesandviews.ui.qr.QrScanFragment"
        android:label="Lector QR" />

    <fragment
        android:id="@+id/pokemonListFragment"
        android:name="com.example.activitiesandviews.ui.pokemon.PokemonListFragment"
        android:label="Pokemones"
        tools:layout="@layout/fragment_pokemon_list">

        <action
            android:id="@+id/action_pokemonList_to_detail"
            app:destination="@id/pokemonDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/pokemonDetailFragment"
        android:name="com.example.activitiesandviews.ui.pokemon.PokemonDetailFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_pokemon_detail">

        <argument
            android:name="pokemonName"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/storageMenuFragment"
        android:name="com.example.activitiesandviews.ui.storage.StorageMenuFragment"
        android:label="Storage"
        tools:layout="@layout/fragment_storage_menu">

        <action
            android:id="@+id/action_storageMenu_to_room"
            app:destination="@id/roomFragment" />

        <action
            android:id="@+id/action_storageMenu_to_files"
            app:destination="@id/filesFragment" />

        <action
            android:id="@+id/action_storageMenu_to_encryptedPrefs"
            app:destination="@id/encryptedPrefsFragment" />

        <action
            android:id="@+id/action_storageMenu_to_profileImage"
            app:destination="@id/profileImageFragment" />
    </fragment>

    <fragment
        android:id="@+id/roomFragment"
        android:name="com.example.activitiesandviews.ui.storage.RoomFragment"
        android:label="Room"
        tools:layout="@layout/fragment_room" />

    <fragment
        android:id="@+id/filesFragment"
        android:name="com.example.activitiesandviews.ui.storage.FilesFragment"
        android:label="Files"
        tools:layout="@layout/fragment_files" />

    <fragment
        android:id="@+id/encryptedPrefsFragment"
        android:name="com.example.activitiesandviews.ui.storage.EncryptedPrefsFragment"
        android:label="EncryptedSharedPreferences"
        tools:layout="@layout/fragment_encrypted_prefs" />

    <fragment
        android:id="@+id/profileImageFragment"
        android:name="com.example.activitiesandviews.ui.storage.ProfileImageFragment"
        android:label="Imagen de Perfil"
        tools:layout="@layout/fragment_profile_image" />

    <fragment
        android:id="@+id/biometricFragment"
        android:name="com.example.activitiesandviews.ui.biometric.BiometricFragment"
        android:label="Biometría"
        tools:layout="@layout/fragment_biometric" />

    <fragment
        android:id="@+id/materialDemoFragment"
        android:name="com.example.activitiesandviews.ui.material.MaterialDemoFragment"
        android:label="Material UI"
        tools:layout="@layout/fragment_material_demo">

        <action
            android:id="@+id/action_material_to_legacy"
            app:destination="@id/legacyDemoFragment" />
    </fragment>

    <fragment
        android:id="@+id/legacyDemoFragment"
        android:name="com.example.activitiesandviews.ui.material.LegacyDemoFragment"
        android:label="Legacy UI"
        tools:layout="@layout/fragment_legacy_demo" />

</navigation>
