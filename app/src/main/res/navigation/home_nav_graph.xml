<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_nav_graph"
    app:startDestination="@id/homeFragment">

    <argument
        android:name="username"
        app:argType="string"
        android:defaultValue="" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.activitiesandviews.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <argument
            android:name="username"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_home_to_pokemon"
            app:destination="@id/pokemonListFragment" />
    </fragment>

    <fragment
        android:id="@+id/pokemonListFragment"
        android:name="com.example.activitiesandviews.ui.pokemon.PokemonListFragment"
        android:label="Pokemones"
        tools:layout="@layout/fragment_pokemon_list">

        <action
            android:id="@+id/action_pokemonList_to_detail"
            app:destination="@id/pokemonDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/pokemonDetailFragment"
        android:name="com.example.activitiesandviews.ui.pokemon.PokemonDetailFragment"
        android:label="Detalle"
        tools:layout="@layout/fragment_pokemon_detail">

        <argument
            android:name="pokemonName"
            app:argType="string"
            android:defaultValue="" />
    </fragment>


</navigation>
