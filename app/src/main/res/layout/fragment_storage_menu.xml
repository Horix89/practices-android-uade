<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Métodos de Persistencia"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona un método para ver su ejemplo"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Room — Datos estructurados (SQL)"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Files — Archivos internos"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnEncryptedPrefs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EncryptedSharedPreferences — Datos sensibles" />

</LinearLayout>
